{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C-teacher",
  "version": "0.2.1",
  "identifier": "com.cteacher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @c-teacher/desktop",
    "beforeBuildCommand": "npm run build --workspace @c-teacher/desktop",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "C-teacher",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi"],
    "externalBin": ["binaries/c-teacher-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
